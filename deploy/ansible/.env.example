# Deployment secrets — modraw-server
# Copy to .env and fill in your real values:
#   cp .env.example .env
#
# This file is local only — never committed to git.

# PostgreSQL (used to create the database user)
PG_PASSWORD=change-me-to-a-strong-db-password

# JWT signing key (generate with: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-random-secret
