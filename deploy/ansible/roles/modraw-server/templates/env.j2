# modraw-server environment — managed by Ansible
PORT=:{{ server_port }}
DATABASE_URL=postgres://{{ pg_user }}:{{ hostvars['localhost'].deploy.PG_PASSWORD | urlencode }}@localhost:5432/{{ pg_database }}?sslmode=disable
JWT_SECRET={{ hostvars['localhost'].deploy.JWT_SECRET }}
ACCESS_TOKEN_TTL={{ access_token_ttl }}
REFRESH_TOKEN_TTL={{ refresh_token_ttl }}
CORS_ORIGINS={{ cors_origins }}
WS_MAX_MSG_SIZE={{ ws_max_msg_size }}
GIN_MODE={{ env }}
